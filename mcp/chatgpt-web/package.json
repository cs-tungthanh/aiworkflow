{
  "name": "chatgpt-web-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that sends review material to ChatGPT web through your own logged-in Chrome and returns the reply",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "chrome": "./start-chrome.sh",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
